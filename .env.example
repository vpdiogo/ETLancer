# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=etlancer

# Authentication
API_KEY=dev-api-key-change-me

# Encryption — generate your own key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Prefect Cloud (production only)
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<ACCOUNT_ID>/workspaces/<WORKSPACE_ID>
PREFECT_API_KEY=

# Frontend (set in Vercel environment variables for production)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_KEY=dev-api-key-change-me
