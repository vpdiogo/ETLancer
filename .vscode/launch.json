{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "POSTGRES_HOST": "localhost"
      }
    },
    {
      "name": "Backend: Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["app/tests/", "-v"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "API_KEY": "test-api-key",
        "ENCRYPTION_KEY": "cYFNSivrrSI20TZVNxKKJvgJsfx9sDvtAtljDMUAtTc="
      }
    },
    {
      "name": "Frontend: Next.js",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
